#!/usr/bin/env sh
# husky pre-commit — 커밋 직전 자동 검증
# 설치: npm install -D husky lint-staged 후 npm run prepare 1회 실행
#
# 실패 시 커밋 차단. 급한 경우 git commit --no-verify 로 우회 가능 (AGENTS.md §2 허용)
# 단, 우회 시 다음 PR 리뷰에서 해명 필요.

npx lint-staged

# 🔴 [2026-08-21] 커밋 누락 가드 — 실사고 재발방지.
#   로더 매니페스트(js/load-groups.js)가 **저장소에 없는 파일**을 부르면 커밋을 막는다.
#   왜 필요한가: 2026-08-21 에 `js/photo/photo-context.js` 등 3개가 untracked 인 채로
#   매니페스트 등록만 커밋·푸시돼 배포본에서 404 가 났다. 내 로컬엔 파일이 있어서
#   파일시스템 검사로는 안 잡혔고, "안 열림"이 아니라 **조용한 낭비**(편집기 열 때마다
#   photo 그룹 89개 재요청)라 눈에도 안 띄었다.
#   같은 워킹트리를 두 세션이 공유하면 `git add -A` 한 번으로 이 상태가 만들어진다.
#   --git 모드는 파일시스템이 아니라 **git(tracked + staged)** 에게 물어서 그걸 잡는다.
node scripts/smoke-check.js --git || {
  echo ''
  echo '커밋을 멈췄습니다 — 로더가 저장소에 없는 파일을 부릅니다.'
  echo '  · 새 파일을 만들었다면 git add 를 빠뜨렸는지 확인하세요.'
  echo '  · 파일을 지웠다면 js/load-groups.js 에서도 지워야 합니다.'
  exit 1
}

# [2026-09-09] 전체화면 오버레이 뒤로가기 등록 가드.
#   back 이 오버레이 대신 뒤 화면을 닫으면 원장이 작성 중이던 예약·캡션이 사라진다.
#   실측으로 확인했고(예약 폼 → 고객 선택창 → back → 예약 폼이 닫힘), 전수 조사에서
#   오버레이 파일 50개 중 32개가 미등록이었다. 여기서 막지 않으면 새 오버레이마다 재발한다.
node scripts/overlay-back-audit.js || {
  echo ''
  echo '커밋을 멈췄습니다 — 뒤로가기에 등록되지 않은 전체화면 오버레이가 있습니다.'
  exit 1
}
