@@ -0,0 +1,237 @@
+"""[운영리스크 2026-09-30 F1] 누끼 Remove.bg 폴백 원가·상한 가드.
+
+문제: Replicate 가 실패해 Remove.bg(장당 약 280원) 로 넘어가도 기록은 `remove-bg`
+(1.4원) 한 줄뿐이었다. 그래서 일일 원가 상한(`ITDASY_DAILY_COST_CAP_KRW`)이 폴백을
+200배 싸게 셌고, 폴백 횟수 자체에도 상한이 없었다.
+
+고친 것:
+  1) 폴백이 실제로 성공하면 `remove-bg-fallback` 행을 **추가로** 남긴다 → 280원으로 집계.
+  2) 하루 폴백 횟수 상한(`REMOVEBG_FALLBACK_DAILY_MAX`, 기본 30, 0=차단).
+  3) 원장님 요금제 쿼터는 그대로(폴백 행은 쿼터에 안 잡힌다).
+"""
+from __future__ import annotations
+
+import io
+import os
+import sys
+
+import pytest
+from fastapi import HTTPException
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+_BACKEND_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
+if _BACKEND_DIR not in sys.path:
+    sys.path.insert(0, _BACKEND_DIR)
+os.environ.setdefault("DATABASE_URL", "sqlite:///:memory:")
+os.environ.setdefault("GEMINI_API_KEY", "test-key")
+
+from database import Base  # noqa: E402
+from models import ApiUsageLog, User  # noqa: E402
+from utils import cost_guard as CG  # noqa: E402
+from utils import plan_limits as PL  # noqa: E402
+
+
+@pytest.fixture
+def db():
+    eng = create_engine("sqlite:///:memory:", connect_args={"check_same_thread": False})
+    Base.metadata.create_all(bind=eng)
+    s = sessionmaker(bind=eng, autocommit=False, autoflush=False)()
+    s.add(User(id=1, email="u@t.com", hashed_password="h", name="원장"))
+    s.commit()
+    yield s
+    s.close()
+    eng.dispose()
+
+
+def _count(db, endpoint):
+    return db.query(ApiUsageLog).filter(ApiUsageLog.endpoint == endpoint).count()
+
+
+# ── 단가·집계 ─────────────────────────────────────────────────────
+
+def test_fallback_has_real_unit_cost():
+    assert CG.UNIT_COST_KRW[CG.REMOVEBG_FALLBACK_ENDPOINT] >= 100, "폴백 단가가 Replicate 단가처럼 싸게 잡히면 안 된다"
+    assert CG.UNIT_COST_KRW[CG.REMOVEBG_FALLBACK_ENDPOINT] > CG.UNIT_COST_KRW["remove-bg"] * 50
+
+
+def test_fallback_counts_toward_daily_spend(db):
+    PL.record_usage(db, 1, "remove-bg")
+    PL.record_usage(db, 1, CG.REMOVEBG_FALLBACK_ENDPOINT)
+    want = CG.UNIT_COST_KRW["remove-bg"] + CG.UNIT_COST_KRW[CG.REMOVEBG_FALLBACK_ENDPOINT]
+    assert CG.today_spend_krw(db) == pytest.approx(want)
+
+
+def test_fallback_row_does_not_touch_plan_quota():
+    assert CG.REMOVEBG_FALLBACK_ENDPOINT not in PL.ENDPOINT_TO_LIMIT
+
+
+def test_daily_cap_trips_after_fallbacks(db, monkeypatch):
+    monkeypatch.setenv("ITDASY_DAILY_COST_CAP_KRW", "500")
+    monkeypatch.setitem(PL.PLAN_LIMITS["free"], "removebg_daily", 999)
+    PL.record_usage(db, 1, CG.REMOVEBG_FALLBACK_ENDPOINT)
+    PL.record_usage(db, 1, CG.REMOVEBG_FALLBACK_ENDPOINT)   # 560원 >= 500원
+    with pytest.raises(HTTPException) as e:
+        PL.check_and_record(db, 1, "remove-bg")
+    assert e.value.status_code == 429
+    assert "daily_cost_cap" in str(e.value.detail)
+
+
+# ── 폴백 횟수 상한 ────────────────────────────────────────────────
+
+def test_default_limit_is_30(monkeypatch):
+    monkeypatch.delenv("REMOVEBG_FALLBACK_DAILY_MAX", raising=False)
+    assert CG.removebg_fallback_daily_max() == 30
+
+
+@pytest.mark.parametrize("raw,want", [("0", 0), ("5", 5), ("-3", 0), ("abc", 30), ("", 30)])
+def test_limit_env_parsing(monkeypatch, raw, want):
+    monkeypatch.setenv("REMOVEBG_FALLBACK_DAILY_MAX", raw)
+    assert CG.removebg_fallback_daily_max() == want
+
+
+def test_allowed_until_limit_then_blocked(db, monkeypatch):
+    monkeypatch.setenv("REMOVEBG_FALLBACK_DAILY_MAX", "2")
+    assert CG.removebg_fallback_allowed(db) is True
+    PL.record_usage(db, 1, CG.REMOVEBG_FALLBACK_ENDPOINT)
+    assert CG.removebg_fallback_allowed(db) is True
+    PL.record_usage(db, 1, CG.REMOVEBG_FALLBACK_ENDPOINT)
+    assert CG.removebg_fallback_allowed(db) is False
+
+
+def test_zero_disables_fallback(db, monkeypatch):
+    monkeypatch.setenv("REMOVEBG_FALLBACK_DAILY_MAX", "0")
+    assert CG.removebg_fallback_allowed(db) is False
+
+
+def test_count_failure_is_fail_closed(monkeypatch):
+    class _Boom:
+        def query(self, *a, **k):
+            raise RuntimeError("db down")
+    monkeypatch.delenv("REMOVEBG_FALLBACK_DAILY_MAX", raising=False)
+    assert CG.removebg_fallback_allowed(_Boom()) is False
+
+
+# ── 라우터 경로: 실제 엔드포인트 호출 (Replicate 실패 → 폴백) ─────────
+
+@pytest.fixture
+def client_env(monkeypatch):
+    """`POST /image/remove-bg` 를 실제로 부른다. 외부 호출·스토리지·동의만 가짜로 바꾼다."""
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    from sqlalchemy.pool import StaticPool
+    from routers import image as IMG
+
+    eng = create_engine("sqlite://", connect_args={"check_same_thread": False}, poolclass=StaticPool)
+    Base.metadata.create_all(bind=eng)
+    Session = sessionmaker(bind=eng, autocommit=False, autoflush=False)
+    s = Session()
+    s.add(User(id=1, email="u@t.com", hashed_password="h", name="원장"))
+    s.commit()
+
+    calls = {"replicate": 0, "removebg": 0}
+    state = {"removebg_ok": True}
+
+    async def _replicate_fail(contents):
+        calls["replicate"] += 1
+        raise RuntimeError("replicate down")
+
+    async def _removebg(contents, filename, content_type):
+        calls["removebg"] += 1
+        if not state["removebg_ok"]:
+            raise RuntimeError("remove.bg down")
+        return b"PNGDATA"
+
+    async def _no_cache(path):
+        return None
+
+    async def _noop_upload(*a, **k):
+        return None
+
+    monkeypatch.setattr(IMG, "REPLICATE_API_TOKEN", "t")
+    monkeypatch.setattr(IMG, "REMOVEBG_API_KEY", "k")
+    monkeypatch.setattr(IMG, "_remove_bg_replicate", _replicate_fail)
+    monkeypatch.setattr(IMG, "_remove_bg_removebg", _removebg)
+    monkeypatch.setattr(IMG, "fetch_object", _no_cache)
+    monkeypatch.setattr(IMG, "upload_to_path", _noop_upload)
+    monkeypatch.setattr(IMG, "require_current_ai_consent", lambda db, uid: None)
+    monkeypatch.setitem(PL.PLAN_LIMITS["free"], "removebg_daily", 999)
+    monkeypatch.delenv("ITDASY_DAILY_COST_CAP_KRW", raising=False)
+
+    app = FastAPI()
+    app.include_router(IMG.router)
+    app.dependency_overrides[IMG.get_current_user] = lambda: 1
+
+    def _db():
+        d = Session()
+        try:
+            yield d
+        finally:
+            d.close()
+    app.dependency_overrides[IMG.get_db] = _db
+
+    # 서로 다른 바이트여야 캐시(컨텐츠 해시) 영향 없이 매번 새로 처리된다.
+    counter = {"n": 0}
+
+    def post():
+        counter["n"] += 1
+        from PIL import Image
+        buf = io.BytesIO()
+        Image.new("RGB", (8, 8), (counter["n"] % 255, 10, 10)).save(buf, format="PNG")
+        return TestClient(app).post(
+            "/image/remove-bg", files={"file": ("a.png", buf.getvalue(), "image/png")})
+
+    yield post, calls, state, s
+    s.close()
+    eng.dispose()
+
+
+def test_fallback_success_records_real_cost(client_env, monkeypatch):
+    post, calls, state, s = client_env
+    monkeypatch.setenv("REMOVEBG_FALLBACK_DAILY_MAX", "5")
+    r = post()
+    assert r.status_code == 200, r.text
+    assert calls == {"replicate": 1, "removebg": 1}
+    assert _count(s, "remove-bg") == 1, "원장님 쿼터는 1회 그대로"
+    assert _count(s, CG.REMOVEBG_FALLBACK_ENDPOINT) == 1, "폴백은 실단가로 따로 기록"
+
+
+def test_fallback_failure_records_no_fallback_cost(client_env, monkeypatch):
+    post, calls, state, s = client_env
+    monkeypatch.setenv("REMOVEBG_FALLBACK_DAILY_MAX", "5")
+    state["removebg_ok"] = False
+    r = post()
+    assert r.status_code == 503
+    assert _count(s, CG.REMOVEBG_FALLBACK_ENDPOINT) == 0
+
+
+def test_fallback_limit_stops_calling_removebg(client_env, monkeypatch):
+    post, calls, state, s = client_env
+    monkeypatch.setenv("REMOVEBG_FALLBACK_DAILY_MAX", "2")
+    assert post().status_code == 200
+    assert post().status_code == 200
+    r = post()
+    assert r.status_code == 503, "상한을 넘으면 Remove.bg 를 부르지 않고 503"
+    assert calls["removebg"] == 2
+    assert _count(s, CG.REMOVEBG_FALLBACK_ENDPOINT) == 2
+
+
+def test_fallback_disabled_by_zero(client_env, monkeypatch):
+    post, calls, state, s = client_env
+    monkeypatch.setenv("REMOVEBG_FALLBACK_DAILY_MAX", "0")
+    assert post().status_code == 503
+    assert calls["removebg"] == 0
+
+
+# ── 관리자 원가 화면에도 폴백 원가가 잡힌다 ─────────────────────────
+
+def test_admin_infra_cost_includes_fallback(db, monkeypatch):
+    from routers import admin as ADM
+    monkeypatch.setattr(ADM, "_gemini_cost_from_logs", lambda db, since: 0.0)
+    monkeypatch.setenv("REMOVEBG_FALLBACK_USD", "0.20")
+    PL.record_usage(db, 1, "remove-bg")
+    PL.record_usage(db, 1, CG.REMOVEBG_FALLBACK_ENDPOINT)
+    out = ADM.stats_infra_cost(period="month", _=1, db=db)
+    assert out.breakdown["removebg_fallback_calls"] == 1
+    want = ADM.REPLICATE_REMOVEBG_USD * 1 + 0.20 * 1
+    assert out.replicate_usd == pytest.approx(want, abs=1e-4)
