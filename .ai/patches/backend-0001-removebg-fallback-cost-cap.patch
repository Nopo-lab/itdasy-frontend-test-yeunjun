+    removebg_fallback_calls = (
+        db.query(sa_func.coalesce(sa_func.sum(ApiUsageLog.count), 0))
+        .filter(ApiUsageLog.used_at >= since)
+        .filter(ApiUsageLog.endpoint == "remove-bg-fallback")
+        .scalar()
+        or 0
+    )
+    try:
+        removebg_fallback_unit_usd = float(os.getenv("REMOVEBG_FALLBACK_USD", "0.20"))
+    except (TypeError, ValueError):
+        removebg_fallback_unit_usd = 0.20
+    replicate_usd += float(removebg_fallback_calls) * removebg_fallback_unit_usd
 
     # 3) Railway 월 고정비
     try:
@@ -1329,6 +1342,8 @@ def stats_infra_cost(
         breakdown={
             "removebg_calls": int(removebg_calls),
             "removebg_unit_usd": REPLICATE_REMOVEBG_USD,
+            "removebg_fallback_calls": int(removebg_fallback_calls),
+            "removebg_fallback_unit_usd": removebg_fallback_unit_usd,
             "railway_monthly_usd": railway_monthly,
             "supabase_monthly_usd": supabase_monthly,
             "usd_krw": USD_KRW,
