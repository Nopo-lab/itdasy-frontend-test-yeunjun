+  REMOVEBG_FALLBACK_DAILY_MAX=30  누끼 Remove.bg 폴백 하루 최대 횟수(전체). 미설정=30, 0=폴백 차단.
 """
 import logging
 import os
@@ -48,6 +49,13 @@ UNIT_COST_KRW = {
     #   3.0(캡션)보다 낮게 잡는 이유: 프롬프트가 짧고(샵 소개 + 영상 설명) 출력이 자막 몇 줄이다.
     "script": 2.0,
     "remove-bg": 1.4,
+    # [운영리스크 2026-09-30 F1] 누끼 **폴백**(Remove.bg) 은 따로 센다.
+    #   `remove-bg` 1.4원은 1순위 Replicate 단가다. Replicate 가 흔들려 Remove.bg 로 넘어가면
+    #   실제로는 장당 약 280원(=Replicate 의 200배, RUNBOOK §3)이 나가는데, 그동안 기록은
+    #   `remove-bg` 한 줄뿐이라 일일 상한이 폴백을 **1.4원으로 셌다** → 상한이 200배 헐거웠다.
+    #   폴백이 실제로 탄 경우에만 이 행을 **추가로** 남긴다(요금제 쿼터에는 안 잡힌다 —
+    #   ENDPOINT_TO_LIMIT 에 없음. 원장님 쿼터는 기존 `remove-bg` 1회 그대로).
+    "remove-bg-fallback": 280.0,
     "ai-enhance": 2.2,
     "ai-remove-object": 2.8,
     "ai-generate-bg": 39.2,
@@ -95,6 +103,52 @@ def feature_disabled(endpoint: str) -> bool:
     return os.environ.get(env, "").strip().lower() in _OFF_VALUES
 
 
+# [운영리스크 2026-09-30 F1] 폴백 하루 최대 횟수 (서비스 전체 합산).
+#   미설정 = 30회(≈8,400원/일). `0` = 폴백 완전 차단(Replicate 실패 시 바로 503).
+#   전체 일일 상한(ITDASY_DAILY_COST_CAP_KRW)이 꺼져 있어도 폴백만큼은 무한정 태우지 않게
+#   **기본값을 둔다.** 폴백은 정상 경로가 아니라 장애 경로라서, 여기서 막혀도 원장님은
+#   "잠시 후 다시" 안내를 받을 뿐 데이터가 사라지지 않는다.
+REMOVEBG_FALLBACK_ENDPOINT = "remove-bg-fallback"
+_REMOVEBG_FALLBACK_DEFAULT_MAX = 30
+
+
+def removebg_fallback_daily_max() -> int:
+    raw = os.environ.get("REMOVEBG_FALLBACK_DAILY_MAX", "").strip()
+    if raw == "":
+        return _REMOVEBG_FALLBACK_DEFAULT_MAX
+    try:
+        return max(int(raw), 0)
+    except ValueError:
+        return _REMOVEBG_FALLBACK_DEFAULT_MAX
+
+
+def removebg_fallback_allowed(db) -> bool:
+    """오늘(UTC) Remove.bg 폴백을 한 번 더 태워도 되는가.
+
+    집계가 실패하면 **막는다**(fail-closed). 다른 상한은 집계 실패 시 통과시키지만,
