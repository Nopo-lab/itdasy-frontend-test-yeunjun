 INJECTION_PATTERNS = [
-    r"(?i)ignore\s+(previous|above|all)\s+(instructions?|prompts?|rules?)",
+    # [운영리스크 2026-09-30] "ignore **all previous** instructions" 처럼 사이에 단어가 둘 이상이면
+    #   통과했다(가장 흔한 형태인데). 수식어 0~3개를 허용한다.
+    r"(?i)ignore\s+(?:(?:all|the|any|of|previous|above|prior|earlier|your)\s+){0,3}(instructions?|prompts?|rules?|directions?)",
     r"(?i)new\s+instructions?",
     r"(?i)system\s*prompt",
     r"(?i)you\s+are\s+now",
