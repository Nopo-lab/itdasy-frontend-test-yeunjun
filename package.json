{
  "name": "itdasy-app",
  "version": "0.1.0",
  "description": "잇데이 스튜디오 iOS/Android 앱 (Capacitor 래핑)",
  "private": true,
  "scripts": {
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "lint": "eslint 'app-*.js' 'components/**/*.js' 'js/**/*.js' --no-error-on-unmatched-pattern --max-warnings=0 || eslint 'app-*.js' 'components/**/*.js' 'js/**/*.js' --no-error-on-unmatched-pattern",
    "lint:fix": "eslint 'app-*.js' 'components/**/*.js' 'js/**/*.js' --no-error-on-unmatched-pattern --fix && stylelint '*.css' --fix",
    "lint:css": "stylelint '*.css'",
    "test": "jest --passWithNoTests",
    "smoke": "node scripts/smoke-check.js",
    "smoke:flow": "node scripts/ws-flow-smoke.js",
    "gc": "node scripts/gc-weekly.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "cordova-plugin-purchase": "^13.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0"
  },
  "overrides": {
    "tar": "^7.5.13",
    "@capacitor/cli": {
      "tar": "^6.2.1"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --no-error-on-unmatched-pattern --max-warnings=0"
    ],
    "*.css": [
      "stylelint"
    ]
  }
}
